<style>
body{
    margin:0;
    font-family:"Noto Sans TC", sans-serif;
    background:#FFF7F0;
    color:#5A3E36;
}
header{
    background:#FFE1D6;
    padding:15px 40px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:sticky;
    top:0;
    z-index:10;
}
nav a{
    margin-left:20px;
    cursor:pointer;
    font-weight:bold;
}
nav a.active{
    color:#D67B6B;
    border-bottom:2px solid #D67B6B;
}
.cart{
    background:#D67B6B;
    color:white;
    padding:6px 14px;
    border-radius:20px;
    margin-left:20px;
    cursor:pointer;
}
section{
    display:none;
    padding:60px 40px;
    text-align:center;
}
section.active{ display:block; }
.cta-btn{
    margin-top:25px;
    padding:14px 36px;
    background:#D67B6B;
    color:white;
    border:none;
    border-radius:30px;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
    box-shadow:0 8px 16px rgba(0,0,0,.15);
    transition:.3s;
}
.cta-btn:hover{
    background:#c56455;
    transform:translateY(-3px);
}

/* ===== 輪播 ===== */
.slider{ width:500px; height:300px; margin:auto; }
.slide{ display:none; }
.slide img{ width: 500px;height: 300px; border-radius:25px; }
.dots{ margin-top:10px; }
.dot{
    height:10px; width:10px;
    margin:0 5px;
    display:inline-block;
    background:#E0B2A5;
    border-radius:50%;
    cursor:pointer;
}
.dot.active{ background:#D67B6B; }

/* ===== 商品 ===== */
.product-list{
    display:flex;
    justify-content:center;
    gap:30px;
    flex-wrap:wrap;
}
.product{
    background:#fff;
    width:220px;
    padding:20px;
    border-radius:20px;
    box-shadow:0 10px 20px rgba(0,0,0,0.08);
    cursor:pointer;
    transition:.3s;
}
.product:hover{ transform:translateY(-8px); }
.product img{
    width:200px; height:200px;
    border-radius:15px;
}

/* ===== 分類 ===== */
.filter{ margin:20px 0 40px; }
.filter button{
    margin:0 8px;
    padding:8px 18px;
    border-radius:20px;
    border:2px solid #D67B6B;
    background:white;
    color:#D67B6B;
    cursor:pointer;
    font-weight:bold;
}
.filter button.active,
.filter button:hover{
    background:#D67B6B;
    color:white;
}

/* ===== Modal ===== */
.modal{
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background:rgba(0,0,0,.4);
}
.modal-content{
    background:white;
    max-width:200px;
    margin:10% auto;
    padding:30px;
    border-radius:25px;
    text-align:center;
    position:relative;
}
.close{
    position:absolute;
    top:15px; right:20px;
    font-size:22px;
    cursor:pointer;
}

.review-section{
    margin-top:60px;
}
.reviews{
    display:flex;
    justify-content:center;
    gap:30px;
    flex-wrap:wrap;
}
.review{
    background:white;
    width:500px;
    padding:20px;
    border-radius:20px;
    box-shadow:0 8px 18px rgba(0,0,0,.08);
    text-align:left;
}
.review strong{
    color:#D67B6B;
}
.review-form{
    width:500px;
    margin:0px auto;
    background:white;
    padding:10px;
    border-radius:20px;
    box-shadow:0 8px 18px rgba(0,0,0,.08);
    text-align:left;
}
.review-form input,
.review-form textarea{
    width:95%;
    padding:10px 14px;
    margin:10px 0;
    border-radius:12px;
    border:1px solid #ddd;
    font-family:inherit;
}
.review-form button{
    background:#D67B6B;
    color:white;
    border:none;
    padding:10px 24px;
    border-radius:20px;
    cursor:pointer;
    font-weight:bold;
}
.review-form button:hover{
    background:#c56455;
}
.stars{
    display:flex;
    gap:6px;
    font-size:24px;
    cursor:pointer;
}
.star{
    color:#ddd;
    transition:.2s;
}
.star.active{
    color:#FFD25A;
}
.review-layout{
    display:flex;
    gap:40px;
    justify-content:center;
    align-items:flex-start;
    margin-top:30px;
    flex-wrap:wrap;
}

.review-list{
    flex:1;
    max-width:500px;
}

.review-list .review{
    margin-bottom:15px;
}

/* 手機版自動改成上下 */
@media (max-width:768px){
    .review-layout{
        flex-direction:column;
        align-items:center;
    }
}


/* ===== 購物車 ===== */
.cart-box{ max-width:420px; }
.cart-item{
    display:flex;
    align-items:center;
    margin:15px 0;
    gap:10px;
}
.cart-item img{
