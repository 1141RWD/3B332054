}
.qty button{
    width:26px; height:26px;
    border-radius:50%;
    background:#D67B6B;
    color:white;
    border:none;
    cursor:pointer;
}

footer{
    background:#F3C6B8;
    padding:25px;
    text-align:center;
    margin-top:40px;
}
</style>
</head>

